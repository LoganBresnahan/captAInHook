{
  "version": 1,
  "handlers": [
    {
      "name": "retriever",
      "command": "/home/oof/captAInHook/examples/payloads/retriever.sh",
      "events": ["PreToolUse"],
      "mode": "resident",
      "failMode": "open",
      "budgetMs": 2000,
      "readinessTimeoutMs": 5000
    },
    {
      "name": "memory",
      "command": "/home/oof/captAInHook/examples/payloads/memory.sh",
      "events": ["Stop"],
      "mode": "oneshot",
      "failMode": "open",
      "budgetMs": 3000
    },
    {
      "name": "mail-digest-ambient",
      "command": "/home/oof/.captainHook/bin/captainHook",
      "args": ["mail", "digest", "--role", "main", "--seam", "ambient"],
      "events": ["SessionStart", "UserPromptSubmit"],
      "mode": "oneshot",
      "failMode": "open",
      "budgetMs": 5000
    },
    {
      "name": "mail-digest-urgent",
      "command": "/home/oof/.captainHook/bin/captainHook",
      "args": ["mail", "digest", "--role", "main", "--seam", "urgent", "--resident"],
      "events": ["PostToolUse"],
      "mode": "resident",
      "failMode": "open",
      "budgetMs": 2000,
      "readinessTimeoutMs": 10000
    },
    {
      "name": "mail-observer-alpha",
      "command": "/home/oof/captAInHook/examples/payloads/starter-mail-observer.sh",
      "events": ["PostToolUse"],
      "mode": "resident",
      "failMode": "open",
      "budgetMs": 2000,
      "readinessTimeoutMs": 5000,
      "env": {
        "MAIL_ROLE": "alpha",
        "MAIL_PEER": "beta",
        "CAPTAINHOOK_BIN": "/home/oof/.captainHook/bin/captainHook"
      }
    },
    {
      "name": "mail-watcher-alpha",
      "command": "/home/oof/captAInHook/examples/payloads/starter-mail-watcher.sh",
      "events": ["Stop"],
      "mode": "oneshot",
      "failMode": "open",
      "budgetMs": 25000,
      "env": {
        "MAIL_ROLE": "alpha",
        "MAIL_PEER": "beta",
        "CAPTAINHOOK_BIN": "/home/oof/.captainHook/bin/captainHook"
      }
    }
  ]
}
