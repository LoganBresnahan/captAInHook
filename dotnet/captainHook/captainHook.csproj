<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>captainHook</AssemblyName>
    <RootNamespace>CaptainHook</RootNamespace>
    <!-- Keep git out of the compiled bytes: content identity must track
         compiled content only (rationale: captainHookActors.fsproj). -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!-- Cross-language interop: the F# actor layer is just another assembly.
       This one line is the whole integration — no bindings, no FFI.
       captainHookWire is the shim/daemon wire contract (ADR-0004 decision 7
       amendment) — the engine and the AOT captainShim share it, so codec,
       identity, and log schema cannot fork. -->
  <ItemGroup>
    <ProjectReference Include="../captainHookActors/captainHookActors.fsproj" />
    <ProjectReference Include="../captainHookWire/captainHookWire.csproj" />
  </ItemGroup>

  <!-- Default harness specs ship INSIDE the assembly (HarnessRegistry reads
       them via GetManifestResourceStream), so the single-binary deployment
       never depends on files lying next to the dll. -->
  <ItemGroup>
    <EmbeddedResource Include="harnesses/*.json" />
  </ItemGroup>

  <!-- The management-API auth decision (ApiAuthGate) is internal — a security
       control, not public surface — but its pure logic is unit-tested directly
       (ADR-0007 auth-token-origin) rather than only through HttpListener, whose
       Host-prefix match already refuses a foreign Host before the gate. -->
  <ItemGroup>
    <InternalsVisibleTo Include="captainHookTests" />
  </ItemGroup>

  <!-- Single-file distribution (ADR-0012): /deploy publishes with
       PublishSingleFile+SelfContained so no host .NET runtime is needed — but
       the FOUR app assemblies stay LOOSE beside the bundle. Two consumers
       require real DLLs on disk: ContentIdentity.Compute (the rendezvous
       identity = MVIDs of *.dll in the deploy dir — a fully-bundled publish
       has none and identity THROWS) and the shim's wire-stamp skew guard
       (TryReadMvid on captainHookWire.dll — missing reads as skew, permanent
       collapse). Keeping exactly the app assemblies loose preserves today's
       identity surface byte-for-byte; the bundle carries only the runtime.
       Probed 2026-07-21: the excluded ENTRY assembly loads fine from beside
       the bundle, and a cold hook + warm answer both work. Dev builds and
       tests are untouched (condition on PublishSingleFile). -->
  <Target Name="KeepAppAssembliesLooseForIdentity"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish
          Condition="'%(Extension)' == '.dll' and ('%(Filename)' == 'captainHook' or '%(Filename)' == 'captainHookWire' or '%(Filename)' == 'captainHookActors' or '%(Filename)' == 'FSharp.Core')">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
